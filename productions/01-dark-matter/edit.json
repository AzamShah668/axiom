   ],
   "c": [
    {
     "at": null,
     "text": "To hold the Coma Cluster together, Zwicky's numbers needed..."
    },
    {
     "at": "सौ गुना",
     "text": "100 TIMES THE VISIBLE MASS",
     "big": true
    },
    {
     "at": "यह संख्या",
     "text": "The number was so strange..."
    },
    {
     "at": "ज़्यादातर astronomers",
     "text": "...most astronomers dismissed it as a measurement error"
    },
    {
     "at": "Zwicky अपने",
     "text": "Zwicky was also famous for his fiery temper"
    },
    {
     "at": "और उनकी बातों",
     "text": "...and he was often not taken seriously"
    },
    {
     "at": "धीरे-धीरे",
     "text": "Slowly, the idea was buried in the pages of an old research paper"
    },
    {
     "at": "Coma Cluster अपनी",
     "text": "The Coma Cluster kept quietly turning..."
    },
    {
     "at": "और उसके साथ",
     "text": "...and with it, a question nobody could answer"
    },
    {
     "at": "अगले लगभग",
     "text": "For the next 40 years..."
    },
    {
     "at": "दुनिया इस",
     "text": "...the world almost forgot this hidden mass"
    }
   ],
