   "c": [
    {
     "at": null,
     "text": "THE 1970s",
     "big": true
    },
    {
     "at": "यह भूला",
     "text": "The forgotten question came back to life..."
    },
    {
     "at": "इस बार American",
     "text": "...this time through American astronomer Vera Rubin"
    },
    {
     "at": "Rubin और",
     "text": "Rubin and her colleague Kent Ford were measuring how fast galaxies spin"
    },
    {
     "at": "शुरुआत",
     "text": "...starting with the neighbouring galaxy, ANDROMEDA"
    },
    {
     "at": "Solar system में",
     "text": "In the Solar System, the rule is simple"
    },
    {
     "at": "Sun से",
     "text": "The farther a planet is from the Sun, the slower it moves"
    },
    {
     "at": "Earth लगभग",
     "text": "EARTH: ~30 km/s"
    },
    {
     "at": "जबकि दूर",
     "text": "NEPTUNE: only ~5 km/s"
    },
    {
     "at": "Galaxies में भी",
     "text": "Galaxies should work the same way..."
    },
    {
     "at": "center के पास",
     "text": "...fast stars near the center, slow ones at the edge"
    },
    {
     "at": "लेकिन Rubin",
     "text": "But Rubin's data told a different story"
    },
    {
     "at": "Galaxy के बिल्कुल",
     "text": "Stars at the very edge moved just as fast as those near the center"
    },
    {
     "at": "इतनी रफ़्तार",
     "text": "At that speed, they should have been flung out of the galaxy"
    },
    {
     "at": "फिर भी galaxy",
     "text": "Yet the galaxy stayed intact"
    },
    {
     "at": "एक galaxy के बाद",
     "text": "Galaxy after galaxy, the same result"
    },
    {
     "at": "इसका एक ही",
     "text": "It could only mean one thing"
    },
    {
     "at": "हर galaxy के अंदर",
     "text": "Something heavy and invisible fills and surrounds every galaxy"
    },
    {
     "at": "Zwicky सही",
     "text": "ZWICKY WAS RIGHT",
     "big": true
    },
    {
     "at": "Vera Rubin का",
     "text": "Vera Rubin died in 2016..."
    },
    {
     "at": "और उन्हें कभी",
     "text": "...without ever receiving a Nobel Prize"
    },
    {
     "at": "आज Chile",
     "text": "Today, one of the world's most advanced observatories, in Chile, bears her name"
    },
    {
     "at": "Vera C. Rubin",
     "text": "VERA C. RUBIN OBSERVATORY",
     "big": true
    }
