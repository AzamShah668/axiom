   "c": [
    {
     "at": null,
     "text": "After Rubin's discovery, the picture of galaxies changed forever"
    },
    {
     "at": "Milky Way लगभग",
     "text": "THE MILKY WAY: about 100,000 light-years across"
    },
    {
     "at": "और उसमें सौ",
     "text": "100+ BILLION STARS",
     "big": true
    },
    {
     "at": "लेकिन यह चमकती",
     "text": "But this glowing disk is only the inner part of the galaxy"
    },
    {
     "at": "इसके चारों",
     "text": "Around it spreads a vast, invisible sphere..."
    },
    {
     "at": "dark matter halo",
     "text": "THE DARK MATTER HALO",
     "big": true
    },
    {
     "at": "यह halo",
     "text": "More than 10 times wider than the visible galaxy"
    },
    {
     "at": "अनुमान है",
     "text": "About 90% of the Milky Way's mass is in this halo"
    },
    {
     "at": "अरबों तारों",
     "text": "This galaxy of billions of stars..."
    },
    {
     "at": "असल में एक",
     "text": "...is really a small disc of light, floating in an invisible ocean"
    },
    {
     "at": "और यह अकेली",
     "text": "And it's not just the Milky Way"
    },
    {
     "at": "ब्रह्मांड की लगभग",
     "text": "Almost every big galaxy was born inside a halo like this..."
    },
    {
     "at": "और उसी के अंदर",
     "text": "...and grew up inside it"
    }
   ],
