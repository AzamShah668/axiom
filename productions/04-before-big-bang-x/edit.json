   "c": [
    {
     "at": null,
     "text": "The universe has a birthday, and scientists know it precisely"
    },
    {
     "at": "दो हज़ार नौ में",
     "text": "In 2009, the European Space Agency launched a satellite: Planck"
    },
    {
     "at": "चार साल तक",
     "text": "For four years it mapped the whole sky in the same light the New Jersey antenna had caught"
    },
    {
     "at": "उस रोशनी में",
     "text": "Faint patterns hidden in that light tell the age of the universe"
    },
    {
     "at": "दो हज़ार अठारह में",
     "text": "In 2018 came Planck's final result: 13.8 billion years"
    },
    {
     "at": "और ग़लती की",
     "text": "Give or take just 20 million years"
    },
    {
     "at": "मतलब जब हमारी",
     "text": "When Earth formed, about 4.6 billion years ago..."
    },
    {
     "at": "तब तक ब्रह्मांड",
     "text": "...the universe was already 9 billion years old"
    },
    {
     "at": "लेकिन ब्रह्मांड की कोई",
     "text": "But the first to say the universe had a beginning was not a telescope. It was a priest"
    }
   ],
