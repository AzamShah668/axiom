   "c": [
    {
     "at": null,
     "text": "1964"
    },
    {
     "at": "America के New Jersey",
     "text": "In New Jersey, America, two scientists were cleaning pigeon droppings out of a giant radio antenna"
    },
    {
     "at": "Arno Penzias",
     "text": "Arno Penzias and Robert Wilson"
    },
    {
     "at": "उनके antenna में",
     "text": "Their antenna picked up a strange hiss that would not go away"
    },
    {
     "at": "दिन हो या रात",
     "text": "Day or night, wherever the antenna pointed, the sound stayed the same"
    },
    {
     "at": "उन्हें लगा",
     "text": "They thought the pigeons and their nests were to blame"
    },
    {
     "at": "कबूतर हटाए गए",
     "text": "The pigeons were removed. The antenna was scrubbed clean"
    },
    {
     "at": "सरसराहट फिर भी",
     "text": "The hiss was still there"
    },
    {
     "at": "वह सरसराहट कोई",
     "text": "The hiss was not a fault. It was the oldest light in the universe..."
    },
    {
     "at": "Big Bang की गूँज",
     "text": "...the echo of the Big Bang"
    },
    {
     "at": "इसी गूँज ने",
     "text": "That echo proved the universe had a beginning"
    },
    {
     "at": "आज हम जानते",
     "text": "Today we know that beginning was 13.8 billion years ago"
    },
    {
     "at": "और scientists के हिसाब",
     "text": "And according to scientists, in its very first instant, it grew 10²⁶ times bigger"
    },
    {
     "at": "इस खोज ने",
     "text": "The discovery later won a Nobel Prize"
    },
    {
     "at": "लेकिन इंसान के",
     "text": "But it also left humanity with its biggest question"
    },
    {
     "at": "ब्रह्मांड शुरू होने",
     "text": "What was there before the universe began?"
    }
   ],
