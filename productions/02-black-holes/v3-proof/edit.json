   "c": [
    {
     "at": null,
     "text": "But the idea was even older than Schwarzschild"
    },
    {
     "at": "सत्रह सौ",
     "text": "1783",
     "big": true
    },
    {
     "at": "Thornhill",
     "text": "The village priest of Thornhill, England..."
    },
    {
     "at": "John Michell",
     "text": "...John Michell"
    },
    {
     "at": "Henry Cavendish",
     "text": "...wrote a long letter to his friend Henry Cavendish"
    },
    {
     "at": "Michell भूकंपों",
     "text": "Michell also studied earthquakes..."
    },
    {
     "at": "और उनका बनाया",
     "text": "...and his balance was later used to weigh the Earth"
    },
    {
     "at": "Michell ने Newton",
     "text": "Using Newton's gravity, he asked a simple question"
    },
    {
     "at": "अगर कोई तारा",
     "text": "What if a star were as dense as the Sun..."
    },
    {
     "at": "लेकिन उससे पाँच",
     "text": "...but 500 times wider?"
    },
    {
     "at": "जवाब चौंकाने",
     "text": "The answer was shocking"
    },
    {
     "at": "उस तारे की gravity",
     "text": "Even light would be too slow to escape its gravity"
    },
    {
     "at": "ऐसा तारा पूरी",
     "text": "Such a star would be completely invisible"
    },
    {
     "at": "Michell ने इन्हें",
     "text": "Michell called them..."
    },
    {
     "at": "dark stars",
     "text": "DARK STARS",
     "big": true
    },
    {
     "at": "और लिखा",
     "text": "They could be found only by the stars orbiting them"
    },
    {
     "at": "लगभग दो सौ",
     "text": "About 200 years later, astronomers did exactly that"
    }
