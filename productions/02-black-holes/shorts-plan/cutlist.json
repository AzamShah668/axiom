 "caps": [
  {
   "sec": "fact6",
   "t": 0.0,
   "end": 67.745,
   "text": "Near a black hole, gravity isn't just strong",
   "big": false,
   "t1": 3.414
  },
  {
   "sec": "fact6",
   "t": 3.414,
   "end": 67.745,
   "text": "It isn't even, either",
   "big": false,
   "t1": 5.074
  },
  {
   "sec": "fact6",
   "t": 5.074,
   "end": 67.745,
   "text": "Whatever part of a falling object is closer to the black hole is pulled much harder",
   "big": false,
   "t1": 12.074
  },
  {
   "sec": "fact6",
   "t": 13.666,
   "end": 67.745,
   "text": "The object gets longer and thinner, like spaghetti",
   "big": false,
   "t1": 18.553
  },
  {
   "sec": "fact6",
   "t": 18.553,
   "end": 67.745,
   "text": "Scientists call it exactly that... spaghettification",
   "big": false,
   "t1": 20.817
  },
  {
   "sec": "fact6",
   "t": 20.817,
   "end": 67.745,
   "text": "SPAGHETTIFICATION",
   "big": true,
   "t1": 22.176
  },
  {
   "sec": "fact6",
   "t": 22.176,
   "end": 67.745,
   "text": "Seen from far away, a falling object slows down near the event horizon, as if time itself stopped",
   "big": false,
   "t1": 29.176
  },
  {
   "sec": "fact6",
   "t": 30.349,
   "end": 67.745,
   "text": "Its light turns red, then dim, and finally disappears",
   "big": false,
   "t1": 35.76
  },
  {
   "sec": "fact6",
   "t": 35.76,
   "end": 67.745,
   "text": "In 2019, this stopped being just an idea",
   "big": false,
   "t1": 38.825
  },
  {
   "sec": "fact6",
   "t": 38.825,
   "end": 67.745,
   "text": "About 210 million light-years away, a Sun-like star passed very close to a supermassive black hole",
   "big": false,
   "t1": 45.825
  },
  {
   "sec": "fact6",
   "t": 46.824,
   "end": 67.745,
   "text": "The black hole tore it into a long stream and swallowed about half its mass",
   "big": false,
   "t1": 53.824
  },
  {
   "sec": "fact6",
   "t": 54.196,
   "end": 67.745,
   "text": "Telescopes including Chile's Very Large Telescope recorded this death for six months",
   "big": false,
   "t1": 61.196
  },
  {
   "sec": "fact6",
   "t": 61.952,
   "end": 67.745,
   "text": "A star had never been seen dying like this, so close",
   "big": false,
   "t1": 68.045
  }
 ],
